# Unified sandbox image for the Cipher Agent session container.
# Contains Python 3.12, Node, bash, and the test/lint tools the agent needs.
#
# Build:
#   cd app/src/infrastructure/sandbox
#   docker build -f Dockerfile.sandbox -t cipher-sandbox:latest .

FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        nodejs \
        npm \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
        pytest \
        pytest-asyncio \
        pytest-cov \
        ruff \
        flake8

RUN npm install -g eslint

WORKDIR /workspace

CMD ["sleep", "infinity"]
